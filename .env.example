# -----------------------------------------------
# Maya AI — Environment Variables
# Copy this file to .env and fill in the values.
# -----------------------------------------------

# App
APP_NAME=Maya AI
BASE_URL=https://your-ngrok-subdomain.ngrok.io
DEBUG=false

# Twilio
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Make.com Webhook
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-unique-webhook-id

# -----------------------------------------------
# Google Sheets Integration
# -----------------------------------------------
# 1. Go to https://console.cloud.google.com
# 2. Create a project and enable the Google Sheets API + Google Drive API
# 3. Create a Service Account and download the JSON key
# 4. Place the JSON key in this project directory
# 5. Share your Google Sheet with the service account email address
#    (found inside the JSON key as "client_email")

# Path to the service account JSON key file (relative to project root)
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# The Sheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# The worksheet tab name (check the tab at the bottom of your sheet)
GOOGLE_SHEET_NAME=Sheet1

# Cache duration in seconds (60 = re-fetch from Google every 60s)
GOOGLE_SHEETS_CACHE_TTL=60
