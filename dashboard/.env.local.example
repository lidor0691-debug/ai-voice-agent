# Maya AI Dashboard — Environment Variables
# Copy to .env.local

# Google Sheets CSV export URL (primary data source)
# File → Share → Publish to web → CSV, or:
# https://docs.google.com/spreadsheets/d/<YOUR_SHEET_ID>/export?format=csv
GOOGLE_SHEETS_CSV_URL=

# URL of the FastAPI backend (fallback when Sheets is unavailable)
API_BASE_URL=http://localhost:8000
