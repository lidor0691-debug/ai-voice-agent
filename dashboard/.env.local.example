# Maya AI Dashboard — Environment Variables
# Copy to .env.local for local development

# Supabase (required) — NEXT_PUBLIC vars are safe for client bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SERVER ONLY, never prefix with NEXT_PUBLIC
SUPABASE_SERVICE_KEY=your-service-role-key

# FastAPI / Railway backend URL — SERVER ONLY, never prefix with NEXT_PUBLIC
API_BASE_URL=http://localhost:8000
