# Maya AI Dashboard — Local Environment Variables

# Google Sheets CSV export URL (primary data source)
# Replace <YOUR_SHEET_ID> with your actual Google Sheet ID
# Example: https://docs.google.com/spreadsheets/d/1abc123xyz/export?format=csv
GOOGLE_SHEETS_CSV_URL=

# FastAPI backend (fallback)
API_BASE_URL=http://localhost:8000
